{
	"compilerOptions": {
		"baseUrl": ".",
		"declaration": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"DOM",
			"ES2020"
		],
		"module": "CommonJS",
		"moduleResolution": "Node",
		"noImplicitReturns": true,
		"outDir": "dist",
		"paths": {
			"api": [
				"api"
			],
			"api/types": [
				"api/types"
			]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2020",
		"types": [
			"node"
		]
	},
	"include": [
		"api/**/*.d.ts",
		"api/**/*.ts",
		"scripts/**/*.js",
		"src/**/*.ts",
		"tests/**/*.ts",
		"vitest.config.ts",
		"webpack.config.js"
	]
}
