{
	"name": "joplin-plugin-live-math",
	"version": "0.1.20",
	"description": "Obsidian-style live KaTeX preview for Joplin's CodeMirror 6 Markdown editor.",
	"main": "dist/index.js",
	"homepage": "https://git.pawelsarkowicz.xyz/ps/Joplin-Live-Math",
	"repository": {
		"type": "git",
		"url": "ssh://git@git.pawelsarkowicz.xyz:2222/ps/Joplin-Live-Math.git"
	},
	"bugs": {
		"url": "https://git.pawelsarkowicz.xyz/ps/Joplin-Live-Math/issues"
	},
	"scripts": {
		"dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && node scripts/archive.js",
		"build": "npm run dist",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check:package": "node scripts/checkPackage.js",
		"test:browser": "npm run dist && playwright test",
		"test:watch": "vitest"
	},
	"keywords": [
		"joplin-plugin",
		"joplin",
		"codemirror",
		"katex",
		"math"
	],
	"license": "MIT",
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"files": [
		"publish"
	],
	"dependencies": {
		"katex": "^0.16.11"
	},
	"devDependencies": {
		"@codemirror/language": "^6.10.2",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.36.8",
		"@lezer/markdown": "^1.7.2",
		"@playwright/test": "^1.63.0",
		"@types/katex": "^0.16.7",
		"@types/node": "^22.10.7",
		"copy-webpack-plugin": "^14.0.0",
		"postcss": "^8.5.28",
		"postcss-value-parser": "^4.2.0",
		"tar": "^7.4.3",
		"ts-loader": "^9.5.1",
		"typescript": "^5.7.3",
		"vitest": "^4.1.11",
		"webpack": "^5.97.1",
		"webpack-cli": "^6.0.1"
	}
}
